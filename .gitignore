# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Scraper artifacts (HTML cache + generated articles/CSV)
data/

# Generated chunk-viewer data (regenerate with `uv run rag-viewer-data`)
chunk_viewer/data.json

# VSCode settings
.vscode/

# Cache files
.pytest_cache/
.ruff_cache/
.mypy_cache/

# IDE settings
.idea/
.cursor/
.cursorrules

# OS files
.DS_Store
.AppleDouble
.LSOverride

# Claude settings
.claude/

# Terraform: provider binaries, module cache, recorded backend config
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Saved plans contain the full resource diff including secrets in plain text.
*.tfplan
*.plan

crash.log
crash.*.log
*_override.tf
*_override.tf.json

# NOT ignored, deliberately:
#   .terraform.lock.hcl   -- pins provider hashes, belongs in version control
#   environments/*.tfvars -- account ids and names, no secrets